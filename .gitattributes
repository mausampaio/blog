# Normaliza quebras de linha: LF no repositório, nativo na cópia de trabalho
* text=auto

# Sempre LF — arquivos consumidos por Linux (CI) ou que quebram com CRLF
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf

# Binários
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
